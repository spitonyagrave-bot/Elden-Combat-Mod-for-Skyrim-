index 0000000..997c78f
--- /dev/null
+++ b/code/game/wp_saber_mb2.cpp
@@ -0,0 +1,843 @@
+/*
+===========================================================================
+MB2-style saber blocking layer for Movie Duels (SP).
+Licensed under the GPL v2 like the rest of this code base.
+
+Active when g_MB2Combat is 1 and the Advanced MD combat mode
+(g_SerenityJediEngineMode 2) is on. It replaces the MD rule
+"holding block always blocks in the right direction" with:
+
+  * Blocking works in all directions (like MB2), it only costs block points.
+  * Perfect block (PB): the defender must AIM at the side the swing comes
+    from (mouse aim, like Movie Battles II). A PB costs no block points,
+    gives +8 BP and bounces the attacker.
+  * A normal block (aim wrong) costs block points, based on the attacker's
+    saber style and both fighters' state.
+  * Out of block points: the block breaks (stagger), and the defender can
+    lose the saber.
+  * MBlock / disarm: hold block, tap attack right before the hit, hold the
+    mirrored direction key (W and S swapped) and aim correctly: the attacker
+    loses the saber.
+  * NPCs use the same rules. Their "aim" is a reaction time: they can only
+    perfect block a swing they had time to see, so fast chains and
+    half-swings get through more often. Difficulty and NPC rank set the
+    reaction time and accuracy.
+===========================================================================
+*/
+
+#include "g_local.h"
+#include "anims.h"
+#include "b_local.h"
+#include "wp_saber.h"
+#include "../cgame/cg_local.h"
+
+extern qboolean G_ControlledByPlayer(const gentity_t* self);
+extern qboolean InFront(vec3_t spot, vec3_t from, vec3_t fromAngles, float threshHold);
+extern int PM_AnimLength(int index, animNumber_t anim);
+extern void PM_AddBlockFatigue(playerState_t* ps, int fatigue);
+extern void wp_block_points_regenerate_over_ride(const gentity_t* self, int override_amt);
+extern void wp_saber_clear_damage_for_ent_num(gentity_t* attacker, int entityNum, int saber_num, int blade_num);
+extern qboolean WP_SaberMBlock(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num, vec3_t hit_loc);
+extern qboolean WP_SaberParry(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num);
+extern qboolean WP_SaberFatiguedParry(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num, vec3_t hit_loc);
+extern void SabBeh_AnimateSlowBounce(gentity_t* self);
+extern void G_Stagger(gentity_t* hit_ent);
+extern void SabBeh_SaberShouldBeDisarmedBlocker(gentity_t* blocker, int saber_num);
+extern void sab_beh_saber_should_be_disarmed_attacker(gentity_t* attacker, int saber_num);
+extern qboolean pm_saber_innonblockable_attack(int anim);
+extern qboolean PM_SaberInParry(int move);
+extern void CGCam_BlockShakeSP(float intensity, int duration);
+extern qboolean PM_SaberInStart(int move);
+extern qboolean pm_saber_in_special_attack(int anim);
+extern qboolean PM_SaberInAttack(int move);
+extern qboolean PM_SaberInTransition(int move);
+extern void G_StartStasisEffect_FORCE_LEVEL_1(const gentity_t* ent, int me_flags, int length, float time_scale, int spin_time);
+extern cvar_t* g_SerenityJediEngineMode;
+extern cvar_t* d_slowmoaction;
+extern cvar_t* d_blockinfo;
+
+// ---------------------------------------------------------------------------
+// Settings (console variables, saved in the config)
+// ---------------------------------------------------------------------------
+static cvar_t* mb2_on;          // 1 = MB2 blocking on
+static cvar_t* mb2_input;       // 0 = aim with the mouse (MB2), 1 = movement keys (controller)
+static cvar_t* mb2_aim_yaw;     // degrees left/right of the enemy that count as "left/right"
+static cvar_t* mb2_aim_pitch;   // degrees above/below the enemy that count as "high/low"
+static cvar_t* mb2_npc_react;   // NPC reaction time in percent (100 = default)
+static cvar_t* mb2_back_damage; // damage of a hit that could not be blocked (from behind)
+static cvar_t* mb2_debug;       // 1 = print what happened on each block
+static cvar_t* mb2_one_hit;     // 1 = a saber hit that is not blocked kills (MB2)
+static cvar_t* mb2_no_auto_parry; // 1 = no automatic parry for the player when not holding block
+static cvar_t* mb2_block_arc;   // width of the block in degrees in front of you (360 = all around)
+
+static void MB2_RegisterCvars()
+{
+	if (mb2_on)
+	{
+		return;
+	}
+	mb2_on = gi.cvar("g_MB2Combat", "1", CVAR_ARCHIVE);
+	mb2_input = gi.cvar("g_MB2BlockInput", "0", CVAR_ARCHIVE);
+	mb2_aim_yaw = gi.cvar("g_MB2AimYaw", "9", CVAR_ARCHIVE);
+	mb2_aim_pitch = gi.cvar("g_MB2AimPitch", "7", CVAR_ARCHIVE);
+	mb2_npc_react = gi.cvar("g_MB2NPCReaction", "100", CVAR_ARCHIVE);
+	mb2_back_damage = gi.cvar("g_MB2BackHitDamage", "30", CVAR_ARCHIVE);
+	mb2_debug = gi.cvar("g_MB2Debug", "0", CVAR_ARCHIVE);
+	mb2_one_hit = gi.cvar("g_MB2OneHitKill", "1", CVAR_ARCHIVE);
+	mb2_no_auto_parry = gi.cvar("g_MB2NoAutoParry", "1", CVAR_ARCHIVE);
+	mb2_block_arc = gi.cvar("g_MB2BlockArc", "150", CVAR_ARCHIVE);
+}
+
+// ---------------------------------------------------------------------------
+// Zones on a 3x3 grid as seen by the defender: column -1 left, 0 middle,
+// 1 right; row 1 high, 0 middle, -1 low.
+// ---------------------------------------------------------------------------
+struct mb2Zone_t
+{
+	int col;
+	int row;
+};
+
+// Where the swing comes from, seen by the DEFENDER. The attacker's right is
+// the defender's left, so the side is mirrored.
+static mb2Zone_t MB2_IncomingZone(const int start_quad)
+{
+	switch (start_quad)
+	{
+	case Q_TR: return { -1, 1 };
+	case Q_T: return { 0, 1 };
+	case Q_TL: return { 1, 1 };
+	case Q_R: return { -1, 0 };
+	case Q_L: return { 1, 0 };
+	case Q_BR: return { -1, -1 };
+	case Q_B: return { 0, -1 };
+	case Q_BL: return { 1, -1 };
+	default: return { 0, 0 };
+	}
+}
+
+static int MB2_Sign(const float v, const float dead)
+{
+	if (v > dead) return 1;
+	if (v < -dead) return -1;
+	return 0;
+}
+
+// The defender's aim relative to the attacker's body.
+static mb2Zone_t MB2_AimZone(const gentity_t* blocker, const gentity_t* attacker)
+{
+	vec3_t from, to, dir, ang;
+	VectorCopy(blocker->client->ps.origin, from);
+	from[2] += blocker->client->ps.viewheight;
+	VectorCopy(attacker->client->ps.origin, to);
+	to[2] += attacker->client->ps.viewheight * 0.75f; // chest height
+	VectorSubtract(to, from, dir);
+	vectoangles(dir, ang);
+
+	// positive yaw difference = looking to the left of the attacker
+	const float d_yaw = AngleSubtract(blocker->client->ps.viewangles[YAW], ang[YAW]);
+	// negative pitch difference = looking above the attacker
+	const float d_pitch = AngleSubtract(blocker->client->ps.viewangles[PITCH], ang[PITCH]);
+
+	mb2Zone_t z;
+	z.col = -MB2_Sign(d_yaw, mb2_aim_yaw->value);
+	z.row = -MB2_Sign(d_pitch, mb2_aim_pitch->value);
+	return z;
+}
+
+// Movement keys as a zone (controller option, and the MBlock key check).
+static mb2Zone_t MB2_KeyZone(const gentity_t* ent)
+{
+	mb2Zone_t z;
+	z.col = MB2_Sign(ent->client->pers.cmd.rightmove, 0);
+	z.row = MB2_Sign(ent->client->pers.cmd.forwardmove, 0);
+	return z;
+}
+
+// How close the aim must be: hard = exact zone, normal = exact or one step
+// up/down/left/right, easy = any neighbour (diagonals too).
+static qboolean MB2_ZoneMatches(const mb2Zone_t& want, const mb2Zone_t& have)
+{
+	if (have.col == 0 && have.row == 0)
+	{
+		return qfalse; // aiming straight at the enemy is not a perfect block, you have to aim at the swing
+	}
+	const int dc = abs(want.col - have.col);
+	const int dr = abs(want.row - have.row);
+	if (dc == 0 && dr == 0)
+	{
+		return qtrue;
+	}
+	if (g_spskill->integer <= 0)
+	{
+		return dc <= 1 && dr <= 1 ? qtrue : qfalse;
+	}
+	if (g_spskill->integer == 1)
+	{
+		return dc + dr <= 1 ? qtrue : qfalse;
+	}
+	return qfalse;
+}
+
+// ---------------------------------------------------------------------------
+// Block point cost of a normal (not perfect) block, MB2 style:
+// heavier styles drain more, and the state of both fighters scales it.
+// ---------------------------------------------------------------------------
+// MB2 (Release 21) style ratings: offense AP / defense DP.
+// Movie Duels style -> MB2 style: fast=Blue, Tavion=Cyan, medium=Yellow,
+// staff=Staff, dual=Duals, Desann=Purple, strong=Red.
+static void MB2_StyleRating(const int style, float* ap, float* dp)
+{
+	switch (style)
+	{
+	case SS_FAST: *ap = 7; *dp = 55; return;
+	case SS_TAVION: *ap = 8; *dp = 48; return;
+	case SS_STAFF: *ap = 8; *dp = 53; return;
+	case SS_DUAL: *ap = 8; *dp = 50; return;
+	case SS_DESANN: *ap = 11; *dp = 48; return;
+	case SS_STRONG: *ap = 12; *dp = 48; return;
+	case SS_MEDIUM:
+	default: *ap = 9; *dp = 50; return;
+	}
+}
+
+// BP drain of a blocked swing: 100 * attacker AP / defender DP (MB2 R21),
+// half for follow-up swings of a combo, plus the R21 state multipliers.
+static int MB2_BlockCost(const gentity_t* blocker, const gentity_t* attacker)
+{
+	float ap, dp, unused;
+	MB2_StyleRating(attacker->client->ps.saberAnimLevel, &ap, &unused);
+	MB2_StyleRating(blocker->client->ps.saberAnimLevel, &unused, &dp);
+	float cost = 100.0f * ap / dp;
+
+	if (attacker->client->ps.saberAttackChainCount > 1)
+	{
+		cost *= 0.5f; // later swings of a combo drain half
+	}
+	if (attacker->client->ps.pm_flags & PMF_DUCKED)
+	{
+		cost *= 0.75f; // crouch attack
+	}
+	if (blocker->client->ps.pm_flags & PMF_DUCKED)
+	{
+		cost *= 1.25f; // crouched defender
+	}
+	if (blocker->client->ps.ManualBlockingFlags & 1 << HOLDINGBLOCKANDATTACK)
+	{
+		cost *= 1.2f; // caught mid-swing
+	}
+
+	const int result = static_cast<int>(cost + 0.5f);
+	return result < 1 ? 1 : result;
+}
+
+// ---------------------------------------------------------------------------
+// NPC "aim": a reaction time. The NPC can perfect block a swing only once
+// it had time to see where it comes from.
+// ---------------------------------------------------------------------------
+static int MB2_NPCReactionMs(const gentity_t* npc)
+{
+	int react;
+	switch (g_spskill->integer)
+	{
+	case 0: react = 460; break;
+	case 1: react = 330; break;
+	default: react = 230; break;
+	}
+	if (npc->NPC)
+	{
+		if (npc->NPC->rank >= RANK_CAPTAIN)
+		{
+			react -= 90; // bosses / masters
+		}
+		else if (npc->NPC->rank >= RANK_LT_COMM)
+		{
+			react -= 50;
+		}
+		else if (npc->NPC->rank <= RANK_CREWMAN)
+		{
+			react += 80; // padawans, cultists
+		}
+	}
+	react = react * mb2_npc_react->integer / 100;
+	return react < 60 ? 60 : react;
+}
+
+static int MB2_NPCPerfectChance(const gentity_t* npc)
+{
+	int chance;
+	switch (g_spskill->integer)
+	{
+	case 0: chance = 35; break;
+	case 1: chance = 55; break;
+	default: chance = 75; break;
+	}
+	if (npc->NPC && npc->NPC->rank >= RANK_CAPTAIN)
+	{
+		chance += 15;
+	}
+	return chance;
+}
+
+static int MB2_NPCDisarmChance(const gentity_t* npc)
+{
+	int chance;
+	switch (g_spskill->integer)
+	{
+	case 0: chance = 2; break;
+	case 1: chance = 5; break;
+	default: chance = 9; break;
+	}
+	if (npc->NPC && npc->NPC->rank >= RANK_CAPTAIN)
+	{
+		chance += 5;
+	}
+	return chance;
+}
+
+// How long the attacker's current swing has been running, in ms.
+static int MB2_SwingElapsedMs(const gentity_t* attacker)
+{
+	const int len = PM_AnimLength(attacker->client->clientInfo.animFileIndex,
+		static_cast<animNumber_t>(attacker->client->ps.torsoAnim));
+	const int elapsed = len - attacker->client->ps.torsoAnimTimer;
+	return elapsed < 0 ? 0 : elapsed;
+}
+
+// ---------------------------------------------------------------------------
+// Cooldowns per entity (MBlock attempt, NPC disarm)
+// ---------------------------------------------------------------------------
+static int mb2_mblock_ready[MAX_GENTITIES];
+static int mb2_hud_perfect_time; // player's last perfect block (wheel flashes green, like MB2)
+static int mb2_hud_disarm_time;  // player's last MBlock disarm (wheel flashes blue, like MB2)
+static int mb2_hud_mbdef_time;   // player's last MB defense: keys right, aim wrong (wheel flashes yellow)
+static int mb2_hud_hit_time;     // saber body hit by or on the player (ring flashes red, MB2 hit effect)
+static int mb2_hud_clash_time;   // saber hit saber, player involved (ring flashes yellow, MB2 hit effect)
+
+// Is the attacker inside the blocker's block arc (MB2: front only)?
+static qboolean MB2_InBlockArc(const gentity_t* blocker, const gentity_t* attacker)
+{
+	const float arc = mb2_block_arc->value;
+	if (arc >= 360.0f)
+	{
+		return qtrue;
+	}
+	vec3_t dir, ang;
+	VectorSubtract(attacker->client->ps.origin, blocker->client->ps.origin, dir);
+	vectoangles(dir, ang);
+	const float d_yaw = fabs(AngleSubtract(blocker->client->ps.viewangles[YAW], ang[YAW]));
+	return d_yaw <= arc * 0.5f ? qtrue : qfalse;
+}
+static int mb2_npc_disarm_ready[MAX_GENTITIES];
+
+static qboolean MB2_IsPlayer(const gentity_t* ent)
+{
+	return ent->s.number < MAX_CLIENTS || G_ControlledByPlayer(ent) ? qtrue : qfalse;
+}
+
+static void MB2_Debug(const gentity_t* blocker, const gentity_t* attacker, const char* what)
+{
+	if (mb2_debug->integer || d_blockinfo->integer)
+	{
+		if (MB2_IsPlayer(blocker) || MB2_IsPlayer(attacker))
+		{
+			gi.Printf(S_COLOR_GREEN "MB2: %s (BP %d)\n", what, blocker->client->ps.blockPoints);
+		}
+	}
+}
+
+static void MB2_MarkBlocked(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num)
+{
+	if (MB2_IsPlayer(blocker) || MB2_IsPlayer(attacker))
+	{
+		mb2_hud_clash_time = level.time;
+	}
+	blocker->client->ps.saberEventFlags |= SEF_PARRIED;
+	attacker->client->ps.saberEventFlags |= SEF_BLOCKED;
+	wp_saber_clear_damage_for_ent_num(attacker, blocker->s.number, saber_num, blade_num);
+}
+
+// A swing that could not be blocked lands on the body.
+static void MB2_HitThrough(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num, vec3_t hit_loc)
+{
+	vec3_t dir;
+	VectorSubtract(blocker->client->ps.origin, attacker->client->ps.origin, dir);
+	dir[2] = 0;
+	VectorNormalize(dir);
+	wp_saber_clear_damage_for_ent_num(attacker, blocker->s.number, saber_num, blade_num);
+	G_Damage(blocker, attacker, attacker, dir, hit_loc, mb2_back_damage->integer, DAMAGE_NO_KNOCKBACK, MOD_SABER);
+}
+
+static void MB2_PerfectBlockEffects(gentity_t* blocker, gentity_t* attacker, vec3_t hit_loc, const int saber_num, const int blade_num)
+{
+	WP_SaberMBlock(blocker, attacker, saber_num, blade_num, hit_loc);
+	SabBeh_AnimateSlowBounce(attacker);
+	wp_block_points_regenerate_over_ride(blocker, 2); // MB2 R21: +2 BP
+	blocker->client->ps.saberFatigueChainCount = MISHAPLEVEL_NONE;
+	blocker->client->ps.userInt3 |= 1 << FLAG_PERFECTBLOCK;
+
+	if (MB2_IsPlayer(blocker))
+	{
+		CGCam_BlockShakeSP(0.35f, 80);
+		mb2_hud_perfect_time = level.time;
+	}
+	G_Sound(blocker, G_SoundIndex(va("sound/weapons/saber/saber_perfectblock%d.mp3", Q_irand(1, 3))));
+	MB2_MarkBlocked(blocker, attacker, saber_num, blade_num);
+}
+
+// Normal block. Returns qfalse when the block points run out: then the
+// guard is broken and the swing goes through to the body (MB2).
+static qboolean MB2_NormalBlock(gentity_t* blocker, gentity_t* attacker, vec3_t hit_loc, const int saber_num, const int blade_num, const float cost_mult = 1.0f)
+{
+	int cost = static_cast<int>(MB2_BlockCost(blocker, attacker) * cost_mult + 0.5f);
+	if (cost < 1)
+	{
+		cost = 1;
+	}
+
+	if (blocker->client->ps.blockPoints <= cost)
+	{
+		// out of block points: the guard breaks and the hit connects
+		blocker->client->ps.blockPoints = 0;
+		MB2_Debug(blocker, attacker, "out of block points - guard broken");
+		return qfalse;
+	}
+
+	PM_AddBlockFatigue(&blocker->client->ps, cost);
+	if (blocker->client->ps.blockPoints <= BLOCK_POINTS_MAX / 2)
+	{
+		WP_SaberFatiguedParry(blocker, attacker, saber_num, blade_num, hit_loc);
+	}
+	else
+	{
+		WP_SaberParry(blocker, attacker, saber_num, blade_num);
+	}
+	if (MB2_IsPlayer(blocker))
+	{
+		CGCam_BlockShakeSP(0.45f, 100);
+	}
+	MB2_MarkBlocked(blocker, attacker, saber_num, blade_num);
+	MB2_Debug(blocker, attacker, va("normal block, cost %d", cost));
+	return qtrue;
+}
+
+// Guard broken (no block points): no parry at all, the swing goes on and the
+// body hit kills (see MB2_BodyHitDamage).
+static qboolean MB2_GuardBroken(gentity_t* blocker)
+{
+	blocker->client->ps.blockPoints = 0;
+	return qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// Entry point, called for every saber-on-saber block in Advanced MD mode.
+// Returns qtrue when the MB2 rules handled the block (the old MD rules are
+// then skipped), qfalse to fall back to the MD rules.
+// ---------------------------------------------------------------------------
+qboolean MB2_ResolveBlock(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num, vec3_t hit_loc)
+{
+	MB2_RegisterCvars();
+
+	if (!mb2_on->integer || g_SerenityJediEngineMode->integer != 2)
+	{
+		return qfalse;
+	}
+	if (!blocker || !attacker || !blocker->client || !attacker->client)
+	{
+		return qfalse;
+	}
+	if (blocker->client->ps.weapon != WP_SABER || attacker->client->ps.weapon != WP_SABER)
+	{
+		return qfalse;
+	}
+	if (pm_saber_innonblockable_attack(attacker->client->ps.torsoAnim))
+	{
+		return qfalse; // special unblockable moves keep their MD behaviour
+	}
+
+	const qboolean player_blocker = MB2_IsPlayer(blocker);
+	const qboolean holding_block = blocker->client->ps.ManualBlockingFlags & 1 << HOLDINGBLOCK ? qtrue : qfalse;
+	const qboolean npc_blocking = blocker->client->ps.ManualBlockingFlags & 1 << MBF_NPCBLOCKING ? qtrue : qfalse;
+
+	if (player_blocker && !holding_block)
+	{
+		if (mb2_no_auto_parry->integer)
+		{
+			// Like MB2: no block held = no automatic parry. The player's
+			// animation is not interrupted and the swing goes on to the body.
+			MB2_Debug(blocker, attacker, "not blocking - no auto parry");
+			return qtrue;
+		}
+		return qfalse; // old MD rules (automatic parry)
+	}
+
+	// 1. Like MB2: the block only covers the front (g_MB2BlockArc). Hits from
+	//    behind or the side go through.
+	if (!MB2_InBlockArc(blocker, attacker))
+	{
+		MB2_Debug(blocker, attacker, "hit from behind/side - block bypassed");
+		return qtrue;
+	}
+
+	const mb2Zone_t incoming = MB2_IncomingZone(saber_moveData[attacker->client->ps.saber_move].startQuad);
+
+	if (player_blocker)
+	{
+		// 2. Player: aim (or keys) decides perfect block
+		const mb2Zone_t aim = mb2_input->integer ? MB2_KeyZone(blocker) : MB2_AimZone(blocker, attacker);
+		const qboolean perfect = MB2_ZoneMatches(incoming, aim);
+
+		// 3. MBlock: tapped attack while blocking, right before the hit
+		const qboolean tapped = blocker->client->ps.ManualBlockingFlags & 1 << PERFECTBLOCKING ? qtrue : qfalse;
+		if (tapped && level.time >= mb2_mblock_ready[blocker->s.number])
+		{
+			// required keys: the attacker's side, height flipped (W and S swapped)
+			const mb2Zone_t keys = MB2_KeyZone(blocker);
+			const qboolean keys_ok = keys.col == -incoming.col && keys.row == -incoming.row ? qtrue : qfalse;
+
+			if (perfect && keys_ok)
+			{
+				mb2_mblock_ready[blocker->s.number] = level.time + 200; // MB2 R20+: 200 ms
+				MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+				sab_beh_saber_should_be_disarmed_attacker(attacker, saber_num);
+				mb2_hud_disarm_time = level.time;
+				if (d_slowmoaction->integer)
+				{
+					G_StartStasisEffect_FORCE_LEVEL_1(blocker, MEF_NO_SPIN, 250, 0.3f, 0);
+				}
+				MB2_Debug(blocker, attacker, "MBLOCK - attacker disarmed");
+				return qtrue;
+			}
+			mb2_mblock_ready[blocker->s.number] = level.time + 200;
+			if (keys_ok && !perfect)
+			{
+				// MB defense: timing and keys right, aim wrong -> half block cost (MB2, yellow)
+				mb2_hud_mbdef_time = level.time;
+				MB2_Debug(blocker, attacker, "MB defense (half cost)");
+				return MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num, 0.5f) ? qtrue : MB2_GuardBroken(blocker);
+			}
+			// failed MBlock: no penalty since MB2 R21
+		}
+
+		if (perfect)
+		{
+			MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+			MB2_Debug(blocker, attacker, "PERFECT BLOCK");
+		}
+		else if (!MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num))
+		{
+			return MB2_GuardBroken(blocker);
+		}
+		return qtrue;
+	}
+
+	// 4. NPC blocker
+	if (!npc_blocking && !(blocker->client->ps.ManualBlockingFlags & 1 << HOLDINGBLOCK)
+		&& !PM_SaberInParry(blocker->client->ps.saber_move))
+	{
+		return qfalse; // NPC was not defending: MD rules
+	}
+
+	const qboolean saw_it = MB2_SwingElapsedMs(attacker) >= MB2_NPCReactionMs(blocker) ? qtrue : qfalse;
+	if (saw_it && Q_irand(0, 99) < MB2_NPCPerfectChance(blocker))
+	{
+		MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+
+		if (level.time >= mb2_npc_disarm_ready[blocker->s.number]
+			&& Q_irand(0, 99) < MB2_NPCDisarmChance(blocker))
+		{
+			mb2_npc_disarm_ready[blocker->s.number] = level.time + 6000;
+			sab_beh_saber_should_be_disarmed_attacker(attacker, saber_num);
+			MB2_Debug(blocker, attacker, "NPC MBlock - you were disarmed");
+		}
+		else
+		{
+			MB2_Debug(blocker, attacker, "NPC perfect block");
+		}
+		return qtrue;
+	}
+
+	if (!MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num))
+	{
+		return MB2_GuardBroken(blocker);
+	}
+	return qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 direction wheel (HUD), drawn around the crosshair.
+//   grey ring  = wheel (shown while a saber enemy is close)
+//   red        = where the enemy's swing comes from (bright when it lands)
+//   white      = your block direction (aim), only while holding block
+//   green      = your aim matches the swing: perfect block ready
+//   green flash = perfect block, blue = disarm (MBlock), yellow = MB defense (like MB2)
+// g_MB2Wheel 0 hides it, g_MB2WheelSize sets the radius.
+// ---------------------------------------------------------------------------
+static cvar_t* mb2_wheel;
+static cvar_t* mb2_wheel_size;
+
+static gentity_t* MB2_HudEnemy(const gentity_t* player)
+{
+	gentity_t* best = nullptr;
+	float best_dist = 400.0f * 400.0f;
+	qboolean best_attacking = qfalse;
+
+	for (int i = 1; i < globals.num_entities; i++)
+	{
+		gentity_t* ent = &g_entities[i];
+		if (!ent->inuse || !ent->client || ent->health <= 0)
+		{
+			continue;
+		}
+		if (ent->client->ps.weapon != WP_SABER || !ent->client->ps.SaberActive())
+		{
+			continue;
+		}
+		if (ent->client->playerTeam == player->client->playerTeam && ent->enemy != player)
+		{
+			continue; // allies only count when they fight you
+		}
+		const float dist = DistanceSquared(ent->client->ps.origin, player->client->ps.origin);
+		if (dist > 400.0f * 400.0f)
+		{
+			continue;
+		}
+		const int move = ent->client->ps.saber_move;
+		const qboolean attacking = (PM_SaberInStart(move) || PM_SaberInAttack(move) || PM_SaberInTransition(move))
+			&& dist < 200.0f * 200.0f ? qtrue : qfalse;
+
+		// a close enemy that is swinging beats any idle one
+		if (attacking && !best_attacking || attacking == best_attacking && dist < best_dist)
+		{
+			best = ent;
+			best_dist = dist;
+			best_attacking = attacking;
+		}
+	}
+	return best;
+}
+
+// MB2-style perfect block indicator (like MB2's pbindicator):
+// a dark ring around the crosshair, shown only while you aim at an enemy.
+// When the enemy swings, a thick green arc on the ring points from your
+// crosshair towards the spot you have to aim at for a perfect block, so it
+// turns with the angle you look at the enemy. On target the whole ring glows.
+// The aspect ratio is corrected so the ring stays round on widescreen.
+static float aspect_fix = 1.0f; // set each frame by MB2_DrawWheel
+
+static void MB2_SetColor(vec4_t c, const float r, const float g, const float b, const float a)
+{
+	c[0] = r;
+	c[1] = g;
+	c[2] = b;
+	c[3] = a;
+}
+
+// arc from angle a0 to a1 (radians, 0 = right, counter-clockwise), drawn as
+// small squares in several bands so it looks like a solid thick stroke
+static void MB2_Arc(const float cx, const float cy, const float a0, const float a1, const float radius,
+	const float width, const float* color)
+{
+	const float dot = 1.2f;
+	const int bands = width > dot ? static_cast<int>(width / (dot * 0.8f)) + 1 : 1;
+	for (int b = 0; b < bands; b++)
+	{
+		const float r = bands > 1 ? radius - width * 0.5f + width * b / (bands - 1) : radius;
+		const int steps = static_cast<int>(fabsf(a1 - a0) * r / (dot * 0.7f)) + 2;
+		for (int i = 0; i < steps; i++)
+		{
+			const float a = a0 + (a1 - a0) * i / (steps - 1);
+			const float x = cx + cosf(a) * r * aspect_fix - dot * aspect_fix * 0.5f;
+			const float y = cy - sinf(a) * r - dot * 0.5f;
+			CG_FillRect(x, y, dot * aspect_fix, dot, color);
+		}
+	}
+}
+
+void MB2_DrawWheel(const float aspect, const float wheel_x, const float wheel_y, const float crosshair_size)
+{
+	// The ring is stretched exactly like the Movie Duels crosshair, so it always
+	// sits around it (the crosshair itself is not aspect-corrected).
+	(void)aspect;
+	aspect_fix = 1.0f;
+	MB2_RegisterCvars();
+	if (!mb2_wheel)
+	{
+		mb2_wheel = gi.cvar("g_MB2Wheel", "1", CVAR_ARCHIVE);
+		mb2_wheel_size = gi.cvar("g_MB2IndicatorGap", "3", CVAR_ARCHIVE); // ring distance from the crosshair edge
+	}
+	if (!mb2_on->integer || !mb2_wheel->integer || g_SerenityJediEngineMode->integer != 2)
+	{
+		return;
+	}
+	const gentity_t* player = &g_entities[0];
+	if (!player->inuse || !player->client || player->health <= 0)
+	{
+		return;
+	}
+	if (player->client->ps.weapon != WP_SABER || !player->client->ps.SaberActive())
+	{
+		return;
+	}
+	const gentity_t* enemy = MB2_HudEnemy(player);
+	if (!enemy)
+	{
+		return;
+	}
+
+	// only while you aim at the enemy (crosshair on or near them)
+	vec3_t from, to, dir, ang;
+	VectorCopy(player->client->ps.origin, from);
+	from[2] += player->client->ps.viewheight;
+	VectorCopy(enemy->client->ps.origin, to);
+	to[2] += enemy->client->ps.viewheight * 0.75f; // chest
+	VectorSubtract(to, from, dir);
+	vectoangles(dir, ang);
+	const float d_yaw = AngleSubtract(player->client->ps.viewangles[YAW], ang[YAW]);     // + = looking left of the enemy
+	const float d_pitch = AngleSubtract(player->client->ps.viewangles[PITCH], ang[PITCH]); // + = looking below the enemy
+	if (fabsf(d_yaw) > 35.0f || fabsf(d_pitch) > 35.0f)
+	{
+		return;
+	}
+
+	const float cx = wheel_x;
+	const float cy = wheel_y;
+	float radius = crosshair_size * 0.5f + mb2_wheel_size->value;
+	if (radius < 9.0f)
+	{
+		radius = 9.0f;
+	}
+	const float width = 3.2f;
+
+	// dark ring
+	vec4_t dark = { 0.0f, 0.0f, 0.0f, 0.3f };
+	MB2_Arc(cx, cy, 0.0f, 2.0f * M_PI, radius, width, dark);
+
+	// flash after a block result (MB2 colours)
+	const int since_perfect = level.time - mb2_hud_perfect_time;
+	const int since_disarm = level.time - mb2_hud_disarm_time;
+	const int since_mbdef = level.time - mb2_hud_mbdef_time;
+	vec4_t flash = { 0, 0, 0, 0 };
+	if (mb2_hud_disarm_time && since_disarm >= 0 && since_disarm < 450)
+	{
+		MB2_SetColor(flash, 0.3f, 0.6f, 1.0f, 1.0f - since_disarm / 450.0f); // blue = disarm
+	}
+	else if (mb2_hud_perfect_time && since_perfect >= 0 && since_perfect < 300)
+	{
+		MB2_SetColor(flash, 0.5f, 1.0f, 0.5f, 1.0f - since_perfect / 300.0f); // green = perfect block
+	}
+	else if (mb2_hud_mbdef_time && since_mbdef >= 0 && since_mbdef < 300)
+	{
+		MB2_SetColor(flash, 1.0f, 0.85f, 0.1f, 1.0f - since_mbdef / 300.0f); // yellow = MB defense
+	}
+	else if (mb2_hud_hit_time && level.time - mb2_hud_hit_time >= 0 && level.time - mb2_hud_hit_time < 350)
+	{
+		MB2_SetColor(flash, 1.0f, 0.1f, 0.1f, 1.0f - (level.time - mb2_hud_hit_time) / 350.0f); // red = body hit
+	}
+	else if (mb2_hud_clash_time && level.time - mb2_hud_clash_time >= 0 && level.time - mb2_hud_clash_time < 250)
+	{
+		MB2_SetColor(flash, 1.0f, 0.9f, 0.2f, 1.0f - (level.time - mb2_hud_clash_time) / 250.0f); // yellow = saber on saber
+	}
+	if (flash[3] > 0.0f)
+	{
+		MB2_Arc(cx, cy, 0.0f, 2.0f * M_PI, radius, width, flash);
+		return;
+	}
+
+	// incoming swing: arc towards the perfect block spot on the enemy
+	const int move = enemy->client->ps.saber_move;
+	if (!(PM_SaberInStart(move) || PM_SaberInAttack(move) || PM_SaberInTransition(move)))
+	{
+		return;
+	}
+	const mb2Zone_t incoming = MB2_IncomingZone(saber_moveData[move].startQuad);
+	if (!incoming.col && !incoming.row)
+	{
+		return;
+	}
+	const float alpha = PM_SaberInAttack(move) ? 1.0f : 0.8f;
+	vec4_t green = { 0.15f, 0.85f, 0.2f, alpha };
+
+	const mb2Zone_t aim = MB2_AimZone(player, enemy);
+	if (MB2_ZoneMatches(incoming, aim) && !mb2_input->integer)
+	{
+		// on target: the whole ring glows green
+		MB2_Arc(cx, cy, 0.0f, 2.0f * M_PI, radius, width, green);
+		return;
+	}
+
+	// target view offset for that zone (see MB2_AimZone), in degrees
+	const float t_yaw = -incoming.col * mb2_aim_yaw->value * 1.8f;
+	const float t_pitch = -incoming.row * mb2_aim_pitch->value * 1.8f;
+	// on screen: right = less yaw, up = less pitch
+	const float scr_right = -(t_yaw - d_yaw);
+	const float scr_up = -(t_pitch - d_pitch);
+	const float a = atan2f(scr_up, scr_right);
+	const float half = DEG2RAD(50.0f);
+	MB2_Arc(cx, cy, a - half, a + half, radius, width, green);
+}
+
+// ---------------------------------------------------------------------------
+// MB2 feel: no forced parry animation for the player when the sabers only
+// touch while the player is not holding block (e.g. just walking).
+// ---------------------------------------------------------------------------
+static qboolean MB2_Active()
+{
+	MB2_RegisterCvars();
+	return mb2_on->integer && g_SerenityJediEngineMode->integer == 2 ? qtrue : qfalse;
+}
+
+qboolean MB2_SkipIdleParry(const gentity_t* defender)
+{
+	if (!MB2_Active() || !mb2_no_auto_parry->integer || !defender || !defender->client)
+	{
+		return qfalse;
+	}
+	if (!MB2_IsPlayer(defender))
+	{
+		return qfalse;
+	}
+	return defender->client->ps.ManualBlockingFlags & 1 << HOLDINGBLOCK ? qfalse : qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 feel: a real saber swing that reaches the body kills in one hit.
+// Only for actual attacks (not transitions or idle touches).
+// ---------------------------------------------------------------------------
+int MB2_BodyHitDamage(const gentity_t* attacker, const gentity_t* victim, const int damage, int* d_flags)
+{
+	if (!MB2_Active() || !mb2_one_hit->integer)
+	{
+		return damage;
+	}
+	if (!attacker || !attacker->client || !victim || !victim->client || victim->health <= 0 || damage <= 0)
+	{
+		return damage;
+	}
+	if ((MB2_IsPlayer(attacker) || MB2_IsPlayer(victim)) && !(*d_flags & DAMAGE_NO_DAMAGE))
+	{
+		mb2_hud_hit_time = level.time;
+	}
+	if (*d_flags & DAMAGE_NO_DAMAGE)
+	{
+		return damage; // armour (beskar) bounce
+	}
+	if (!PM_SaberInAttack(attacker->client->ps.saber_move)
+		&& !pm_saber_in_special_attack(attacker->client->ps.torsoAnim))
+	{
+		return damage; // not a real swing
+	}
+	if (victim->client->ps.ManualBlockingFlags & (1 << HOLDINGBLOCK | 1 << MBF_NPCBLOCKING)
+		&& victim->client->ps.blockPoints > 0
+		&& MB2_InBlockArc(victim, attacker))
+	{
+		return damage; // blocking from the front with block points left: normal MD damage
+	}
+	*d_flags &= ~DAMAGE_NO_KILL;
+	const int lethal = victim->health + victim->client->ps.stats[STAT_ARMOR] + 10;
+	if (MB2_IsPlayer(attacker) || MB2_IsPlayer(victim))
+	{
+		MB2_Debug(victim, attacker, "unblocked hit - lethal");
+	}
+	return lethal > damage ? lethal : damage;
+}
