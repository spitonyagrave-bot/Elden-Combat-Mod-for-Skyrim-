+// Test log (v15): every block / body hit with the player involved is written
+// to mb2_log.txt in the MD folder, so we can see why NPCs do not block.
+// g_MB2Log 0 turns it off.
+static cvar_t* mb2_log;
+static fileHandle_t mb2_log_file;
+
+static void MB2_Log(const char* line)
+{
+	if (!mb2_log)
+	{
+		mb2_log = gi.cvar("g_MB2TestLog", "0", CVAR_ARCHIVE);
+	}
+	if (!mb2_log->integer)
+	{
+		return;
+	}
+	if (!mb2_log_file)
+	{
+		gi.FS_FOpenFile("mb2_log.txt", &mb2_log_file, FS_APPEND);
+		if (!mb2_log_file)
+		{
+			return;
+		}
+	}
+	const char* full = va("%8d %s\r\n", level.time, line);
+	gi.FS_Write(full, strlen(full), mb2_log_file);
+}
