+// Movie Duels' tap-attack feint (release attack during the wind-up). Off
+// with MB2 combat: one click = full swing. g_MB2TapFeint 1 brings it back.
+qboolean MB2_TapFeint()
+{
+	MB2_RegisterCvars();
+	if (!mb2_on->integer || g_SerenityJediEngineMode->integer != 2)
+	{
+		return qtrue; // Movie Duels behaviour
+	}
+	static cvar_t* tap = nullptr;
+	if (!tap)
+	{
+		tap = gi.cvar("g_MB2TapFeint", "0", CVAR_ARCHIVE);
+	}
+	return tap->integer ? qtrue : qfalse;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 swing tempo: every style swings a bit slower so the direction can be
+// read by eye (Joel: red was readable but too slow, the rest too fast).
+// Factor on top of Movie Duels' own speed; g_MB2SwingSpeed scales all.
+// Only attacks, starts, transitions and returns, not bounces or parries.
+// ---------------------------------------------------------------------------
+static cvar_t* mb2_swing_speed;
+
+static qboolean MB2_IsSwingAnim(const int anim)
+{
+	static const int first[7] = { BOTH_A1_T__B_, BOTH_A2_T__B_, BOTH_A3_T__B_, BOTH_A4_T__B_, BOTH_A5_T__B_, BOTH_A6_T__B_, BOTH_A7_T__B_ };
+	static const int end[7] = { BOTH_B1_BR___, BOTH_B2_BR___, BOTH_B3_BR___, BOTH_B4_BR___, BOTH_B5_BR___, BOTH_B6_BR___, BOTH_B7_BR___ };
+	for (int i = 0; i < 7; i++)
+	{
+		if (anim >= first[i] && anim < end[i])
+		{
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+
+float MB2_SwingSpeedFactor(const gentity_t* gent, const int saber_anim_level, const int anim)
+{
+	MB2_RegisterCvars();
+	if (!mb2_on->integer || g_SerenityJediEngineMode->integer != 2 || !gent || !gent->client
+		|| gent->client->ps.weapon != WP_SABER || !MB2_IsSwingAnim(anim))
+	{
+		return 1.0f;
+	}
+	if (!mb2_swing_speed)
+	{
+		mb2_swing_speed = gi.cvar("g_MB2SwingSpeed", "1", CVAR_ARCHIVE);
+	}
+	float f = 1.0f; // Joel (v15): back to the standard Movie Duels Advanced tempo
+	(void)saber_anim_level;
+	f *= mb2_swing_speed->value > 0.2f ? mb2_swing_speed->value : 1.0f;
+	return f;
+}
+
+// How long the attacker's current swing has been running, in ms.
+static int MB2_SwingElapsedMs(const gentity_t* attacker)
+{
+	const int len = PM_AnimLength(attacker->client->clientInfo.animFileIndex,
+		static_cast<animNumber_t>(attacker->client->ps.torsoAnim));
+	const float f = MB2_SwingSpeedFactor(attacker, attacker->client->ps.saberAnimLevel, attacker->client->ps.torsoAnim);
+	const int real_len = static_cast<int>(len / (f > 0.1f ? f : 1.0f)); // slowed swings last longer
+	const int elapsed = real_len - attacker->client->ps.torsoAnimTimer;
+	return elapsed < 0 ? 0 : elapsed;
+}
