+static void MB2_MarkBlocked(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num)
+{
+	if (MB2_IsPlayer(blocker) || MB2_IsPlayer(attacker))
+	{
+		mb2_hud_clash_time = level.time;
+	}
+	blocker->client->ps.saberEventFlags |= SEF_PARRIED;
+	attacker->client->ps.saberEventFlags |= SEF_BLOCKED;
+	wp_saber_clear_damage_for_ent_num(attacker, blocker->s.number, saber_num, blade_num);
+}
+
+// A swing that could not be blocked lands on the body.
+static void MB2_HitThrough(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num, vec3_t hit_loc)
+{
+	vec3_t dir;
+	VectorSubtract(blocker->client->ps.origin, attacker->client->ps.origin, dir);
+	dir[2] = 0;
+	VectorNormalize(dir);
+	wp_saber_clear_damage_for_ent_num(attacker, blocker->s.number, saber_num, blade_num);
+	G_Damage(blocker, attacker, attacker, dir, hit_loc, mb2_back_damage->integer, DAMAGE_NO_KNOCKBACK, MOD_SABER);
+}
+
+static void MB2_PerfectBlockEffects(gentity_t* blocker, gentity_t* attacker, vec3_t hit_loc, const int saber_num, const int blade_num)
+{
+	WP_SaberMBlock(blocker, attacker, saber_num, blade_num, hit_loc);
+	SabBeh_AnimateSlowBounce(attacker);
+	wp_block_points_regenerate_over_ride(blocker, 2); // MB2 R21: +2 BP
+	blocker->client->ps.saberFatigueChainCount = MISHAPLEVEL_NONE;
+	blocker->client->ps.userInt3 |= 1 << FLAG_PERFECTBLOCK;
+
+	if (MB2_IsPlayer(blocker))
+	{
+		CGCam_BlockShakeSP(0.35f, 80);
+		mb2_hud_perfect_time = level.time;
+	}
+	G_Sound(blocker, G_SoundIndex(va("sound/weapons/saber/saber_perfectblock%d.mp3", Q_irand(1, 3))));
+	MB2_MarkBlocked(blocker, attacker, saber_num, blade_num);
+}
+
+// Normal block. Returns qfalse when the block points run out: then the
+// guard is broken and the swing goes through to the body (MB2).
+static qboolean MB2_NormalBlock(gentity_t* blocker, gentity_t* attacker, vec3_t hit_loc, const int saber_num, const int blade_num, const float cost_mult = 1.0f)
+{
+	int cost = static_cast<int>(MB2_BlockCost(blocker, attacker) * cost_mult + 0.5f);
+	if (cost < 1)
+	{
+		cost = 1;
+	}
+
+	if (blocker->client->ps.blockPoints <= cost)
+	{
+		// out of block points: the guard breaks and the hit connects
+		blocker->client->ps.blockPoints = 0;
+		MB2_Debug(blocker, attacker, "out of block points - guard broken");
+		return qfalse;
+	}
+
+	PM_AddBlockFatigue(&blocker->client->ps, cost);
+	if (blocker->client->ps.blockPoints <= BLOCK_POINTS_MAX / 2)
+	{
+		WP_SaberFatiguedParry(blocker, attacker, saber_num, blade_num, hit_loc);
+	}
+	else
+	{
+		WP_SaberParry(blocker, attacker, saber_num, blade_num);
+	}
+	if (MB2_IsPlayer(blocker))
+	{
+		CGCam_BlockShakeSP(0.45f, 100);
+	}
+	MB2_MarkBlocked(blocker, attacker, saber_num, blade_num);
+	MB2_Debug(blocker, attacker, va("normal block, cost %d", cost));
+	return qtrue;
+}
+
+// Guard broken (no block points).
+// g_MB2GuardBreak 1 (default, epic fights): the swing is still stopped, but
+// the defender loses the saber (see MB2_KnockSaberAway); a hit in that window
+// kills. Afterwards the guard comes back with some block points.
+// g_MB2GuardBreak 0: hard MB2 - the swing goes on and the body hit kills.
+static int mb2_guard_open_until[MAX_GENTITIES];
+static cvar_t* mb2_guard_break;
+
+static qboolean MB2_GuardOpen(const gentity_t* ent)
+{
+	return level.time < mb2_guard_open_until[ent->s.number] ? qtrue : qfalse;
+}
+
+// after the open window: guard back with 30 block points
+static void MB2_GuardRecover(gentity_t* ent)
+{
+	const int n = ent->s.number;
+	if (mb2_guard_open_until[n] && level.time >= mb2_guard_open_until[n])
+	{
+		mb2_guard_open_until[n] = 0;
+		if (ent->client && ent->client->ps.blockPoints < 30)
+		{
+			ent->client->ps.blockPoints = 30;
+		}
+	}
+}
+
+// Joel (v14): at 0 block points the saber flies out of the hand; the next
+// hit kills. Sabers that cannot be disarmed: a stagger instead. Open for 3 s
+// (about the time to get the saber back), then the guard returns.
+static void MB2_KnockSaberAway(gentity_t* ent)
+{
+	mb2_guard_open_until[ent->s.number] = level.time + 3000;
+	if (!ent->client->ps.saberInFlight
+		&& !(ent->client->ps.saber[0].saberFlags & SFL_NOT_DISARMABLE)
+		&& !in_camera)
+	{
+		SabBeh_SaberShouldBeDisarmedBlocker(ent, 0);
+	}
+	else
+	{
+		G_Stagger(ent);
+	}
+}
+
+static qboolean MB2_GuardBroken(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num)
+{
+	blocker->client->ps.blockPoints = 0;
+	if (!mb2_guard_break)
+	{
+		mb2_guard_break = gi.cvar("g_MB2GuardBreak", "1", CVAR_ARCHIVE);
+	}
+	if (!mb2_guard_break->integer || MB2_GuardOpen(blocker))
+	{
+		return qtrue; // hard rule, or already open: the swing goes through
+	}
+	MB2_MarkBlocked(blocker, attacker, saber_num, blade_num); // this swing is still stopped
+	MB2_KnockSaberAway(blocker);
+	MB2_Debug(blocker, attacker, "guard broken - saber knocked away, next hit kills");
+	return qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// Entry point, called for every saber-on-saber block in Advanced MD mode.
+// Returns qtrue when the MB2 rules handled the block (the old MD rules are
+// then skipped), qfalse to fall back to the MD rules.
+// ---------------------------------------------------------------------------
+qboolean MB2_ResolveBlock(gentity_t* blocker, gentity_t* attacker, const int saber_num, const int blade_num, vec3_t hit_loc)
+{
+	MB2_RegisterCvars();
+
+	if (!mb2_on->integer || g_SerenityJediEngineMode->integer != 2)
+	{
+		return qfalse;
+	}
+	if (!blocker || !attacker || !blocker->client || !attacker->client)
+	{
+		return qfalse;
+	}
+	if (blocker->client->ps.weapon != WP_SABER || attacker->client->ps.weapon != WP_SABER)
+	{
+		return qfalse;
+	}
+	if (PM_SaberInnonblockableAttack(attacker->client->ps.torsoAnim))
+	{
+		return qfalse; // special unblockable moves keep their MD behaviour
+	}
+
+	MB2_GuardRecover(blocker);
+	if (MB2_GuardOpen(blocker))
+	{
+		MB2_Debug(blocker, attacker, "guard open - hit goes through");
+		return qtrue; // staggered: no block, the swing reaches the body
+	}
+
+	const qboolean player_blocker = MB2_IsPlayer(blocker);
+	const qboolean holding_block = blocker->client->ps.ManualBlockingFlags & 1 << MBF_HOLDINGBLOCK ? qtrue : qfalse;
+	const qboolean npc_blocking = blocker->client->ps.ManualBlockingFlags & 1 << MBF_NPCBLOCKING ? qtrue : qfalse;
+
+	if (player_blocker && !holding_block)
+	{
+		if (mb2_no_auto_parry->integer)
+		{
+			// Like MB2: no block held = no automatic parry. The player's
+			// animation is not interrupted and the swing goes on to the body.
+			MB2_Debug(blocker, attacker, "not blocking - no auto parry");
+			return qtrue;
+		}
+		return qfalse; // old MD rules (automatic parry)
+	}
+
+	// 1. Like MB2: the block only covers the front (g_MB2BlockArc). Hits from
+	//    behind or the side go through.
+	if (!MB2_InBlockArc(blocker, attacker))
+	{
+		MB2_Debug(blocker, attacker, "hit from behind/side - block bypassed");
+		return qtrue;
+	}
+
+	const mb2Zone_t incoming = MB2_IncomingZone(saberMoveData[attacker->client->ps.saberMove].startQuad);
+
+	if (player_blocker)
+	{
+		// 2. Player: aim (or keys) decides perfect block
+		qboolean perfect;
+		qboolean semi = qfalse;
+		if (mb2_input->integer)
+		{
+			perfect = MB2_ZoneMatches(incoming, MB2_KeyZone(blocker));
+		}
+		else
+		{
+			const int res = MB2_FieldResult(incoming, MB2_AimField(blocker, attacker));
+			perfect = res == 2 ? qtrue : qfalse;
+			semi = res == 1 ? qtrue : qfalse;
+		}
+
+		// 3. MBlock: tapped attack while blocking, right before the hit
+		const qboolean tapped = blocker->client->ps.ManualBlockingFlags & 1 << MBF_PERFECTBLOCKING ? qtrue : qfalse;
+		if (tapped && level.time >= mb2_mblock_ready[blocker->s.number])
+		{
+			// required keys: the attacker's side, height flipped (W and S swapped)
+			const mb2Zone_t keys = MB2_KeyZone(blocker);
+			const qboolean keys_ok = keys.col == -incoming.col && keys.row == -incoming.row ? qtrue : qfalse;
+
+			if (perfect && keys_ok)
+			{
+				mb2_mblock_ready[blocker->s.number] = level.time + 200; // MB2 R20+: 200 ms
+				MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+				sab_beh_saber_should_be_disarmed_attacker(attacker, saber_num);
+				mb2_hud_disarm_time = level.time;
+				if (d_slowmoaction->integer)
+				{
+					G_StartStasisEffect_FORCE_LEVEL_1(blocker, MEF_NO_SPIN, 250, 0.3f, 0);
+				}
+				MB2_Debug(blocker, attacker, "MBLOCK - attacker disarmed");
+				return qtrue;
+			}
+			mb2_mblock_ready[blocker->s.number] = level.time + 200;
+			if (keys_ok && !perfect)
+			{
+				// MB defense: timing and keys right, aim wrong -> half block cost (MB2, yellow)
+				mb2_hud_mbdef_time = level.time;
+				MB2_Debug(blocker, attacker, "MB defense (half cost)");
+				return MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num, 0.5f) ? qtrue : MB2_GuardBroken(blocker, attacker, saber_num, blade_num);
+			}
+			// failed MBlock: no penalty since MB2 R21
+		}
+
+		if (perfect)
+		{
+			MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+			MB2_Debug(blocker, attacker, "PERFECT BLOCK");
+		}
+		else if (semi)
+		{
+			mb2_hud_semi_time = level.time;
+			MB2_Debug(blocker, attacker, "semi block (half cost)");
+			if (!MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num, 0.5f))
+			{
+				return MB2_GuardBroken(blocker, attacker, saber_num, blade_num);
+			}
+		}
+		else if (!MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num))
+		{
+			return MB2_GuardBroken(blocker, attacker, saber_num, blade_num);
+		}
+		return qtrue;
+	}
+
+	// 4. NPC blocker
+	if (!npc_blocking && !(blocker->client->ps.ManualBlockingFlags & 1 << MBF_HOLDINGBLOCK)
+		&& !PM_SaberInParry(blocker->client->ps.saberMove))
+	{
+		MB2_Debug(blocker, attacker, "NPC not in block state - Movie Duels rules");
+		return qfalse; // NPC was not defending: MD rules
+	}
+
+	const qboolean saw_it = MB2_SwingElapsedMs(attacker) >= MB2_NPCReactionMs(blocker) ? qtrue : qfalse;
+	if (saw_it && Q_irand(0, 99) < MB2_NPCPerfectChance(blocker))
+	{
+		MB2_PerfectBlockEffects(blocker, attacker, hit_loc, saber_num, blade_num);
+
+		if (level.time >= mb2_npc_disarm_ready[blocker->s.number]
+			&& Q_irand(0, 99) < MB2_NPCDisarmChance(blocker))
+		{
+			mb2_npc_disarm_ready[blocker->s.number] = level.time + 6000;
+			sab_beh_saber_should_be_disarmed_attacker(attacker, saber_num);
+			MB2_Debug(blocker, attacker, "NPC MBlock - you were disarmed");
+		}
+		else
+		{
+			MB2_Debug(blocker, attacker, "NPC perfect block");
+		}
+		return qtrue;
+	}
+
+	// NPC semi block: saw the swing but aimed a zone off -> half cost
+	if (saw_it && Q_irand(0, 99) < MB2_NPCSemiChance(blocker))
+	{
+		MB2_Debug(blocker, attacker, "NPC semi block (half cost)");
+		return MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num, 0.5f) ? qtrue : MB2_GuardBroken(blocker, attacker, saber_num, blade_num);
+	}
+	if (!MB2_NormalBlock(blocker, attacker, hit_loc, saber_num, blade_num))
+	{
+		return MB2_GuardBroken(blocker, attacker, saber_num, blade_num);
+	}
+	return qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 direction wheel (HUD), drawn around the crosshair.
+//   grey ring  = wheel (shown while a saber enemy is close)
+//   red        = where the enemy's swing comes from (bright when it lands)
+//   white      = your block direction (aim), only while holding block
+//   green      = your aim matches the swing: perfect block ready
+//   green flash = perfect block, blue = disarm (MBlock), yellow = MB defense (like MB2)
+// g_MB2Wheel 0 hides it, g_MB2WheelSize sets the radius.
+// ---------------------------------------------------------------------------
+static cvar_t* mb2_wheel;
+static cvar_t* mb2_wheel_size;
+static cvar_t* mb2_hint;
+
+static gentity_t* MB2_HudEnemy(const gentity_t* player)
+{
+	gentity_t* best = nullptr;
+	float best_dist = 400.0f * 400.0f;
+	qboolean best_attacking = qfalse;
+
+	for (int i = 1; i < globals.num_entities; i++)
+	{
+		gentity_t* ent = &g_entities[i];
+		if (!ent->inuse || !ent->client || ent->health <= 0)
+		{
+			continue;
+		}
+		if (ent->client->ps.weapon != WP_SABER || !ent->client->ps.SaberActive())
+		{
+			continue;
+		}
+		if (ent->client->playerTeam == player->client->playerTeam && ent->enemy != player)
+		{
+			continue; // allies only count when they fight you
+		}
+		const float dist = DistanceSquared(ent->client->ps.origin, player->client->ps.origin);
+		if (dist > 400.0f * 400.0f)
+		{
+			continue;
+		}
+		const int move = ent->client->ps.saberMove;
+		const qboolean attacking = (PM_SaberInStart(move) || PM_SaberInAttack(move) || PM_SaberInTransition(move))
+			&& dist < 200.0f * 200.0f ? qtrue : qfalse;
+
+		// a close enemy that is swinging beats any idle one
+		if (attacking && !best_attacking || attacking == best_attacking && dist < best_dist)
+		{
+			best = ent;
+			best_dist = dist;
+			best_attacking = attacking;
+		}
+	}
+	return best;
+}
+
+// MB2-style perfect block indicator (like MB2's pbindicator):
+// a dark ring around the crosshair, shown only while you aim at an enemy.
+// When the enemy swings, a thick green arc on the ring points from your
+// crosshair towards the spot you have to aim at for a perfect block, so it
+// turns with the angle you look at the enemy. On target the whole ring glows.
+// The aspect ratio is corrected so the ring stays round on widescreen.
+static float aspect_fix = 1.0f; // set each frame by MB2_DrawWheel
+static mb2Zone_t mb2_hud_inc_zone = { 0, 0 }; // last incoming swing direction
+static int mb2_hud_inc_time;                   // when it was last seen
+
+static void MB2_SetColor(vec4_t c, const float r, const float g, const float b, const float a)
+{
+	c[0] = r;
+	c[1] = g;
+	c[2] = b;
+	c[3] = a;
+}
+
+// arc from angle a0 to a1 (radians, 0 = right, counter-clockwise), drawn as
+// small squares in several bands so it looks like a solid thick stroke
+static void MB2_Arc(const float cx, const float cy, const float a0, const float a1, const float radius,
+	const float width, const float* color)
+{
+	const float dot = 0.7f;
+	const int bands = width > dot ? static_cast<int>(width / (dot * 0.5f)) + 1 : 1;
+	for (int b = 0; b < bands; b++)
+	{
+		const float r = bands > 1 ? radius - width * 0.5f + width * b / (bands - 1) : radius;
+		const int steps = static_cast<int>(fabsf(a1 - a0) * r / (dot * 0.4f)) + 2; // dense, so it looks like a solid line
+		for (int i = 0; i < steps; i++)
+		{
+			const float a = a0 + (a1 - a0) * i / (steps - 1);
+			const float x = cx + cosf(a) * r * aspect_fix - dot * aspect_fix * 0.5f;
+			const float y = cy - sinf(a) * r - dot * 0.5f;
+			CG_FillRect(x, y, dot * aspect_fix, dot, color);
+		}
+	}
+}
+
+void MB2_DrawWheel(const float aspect, const float wheel_x, const float wheel_y, const float crosshair_size)
+{
+	// Stretched exactly like the Movie Duels crosshair (which is not aspect
+	// corrected), so the ring always sits evenly around it.
+	// round on widescreen (Joel: the stretched ring looked too thick/wide)
+	aspect_fix = aspect > 0.3f && aspect <= 1.0f ? aspect : 1.0f;
+	MB2_RegisterCvars();
+	if (!mb2_wheel)
+	{
+		mb2_wheel = gi.cvar("g_MB2Wheel", "1", CVAR_ARCHIVE);
+		mb2_wheel_size = gi.cvar("g_MB2IndicatorSize", "11", CVAR_ARCHIVE); // ring radius (virtual 640x480 pixels)
+		mb2_hint = gi.cvar("g_MB2IncomingHint", "1", CVAR_ARCHIVE); // orange field = where the swing comes from
+	}
+	if (!mb2_on->integer || !mb2_wheel->integer || g_SerenityJediEngineMode->integer != 2)
+	{
+		return;
+	}
+	const gentity_t* player = &g_entities[0];
+	if (!player->inuse || !player->client || player->health <= 0)
+	{
+		return;
+	}
+	if (player->client->ps.weapon != WP_SABER || !player->client->ps.SaberActive())
+	{
+		return;
+	}
+	const gentity_t* enemy = MB2_HudEnemy(player);
+	if (!enemy)
+	{
+		return;
+	}
+
+	// only while you aim at the enemy (crosshair on or near them)
+	vec3_t from, to, dir, ang;
+	VectorCopy(player->client->ps.origin, from);
+	from[2] += player->client->ps.viewheight;
+	VectorCopy(enemy->client->ps.origin, to);
+	to[2] += enemy->client->ps.viewheight * 0.5f; // chest
+	VectorSubtract(to, from, dir);
+	vectoangles(dir, ang);
+	const float d_yaw = AngleSubtract(player->client->ps.viewangles[YAW], ang[YAW]);     // + = looking left of the enemy
+	const float d_pitch = AngleSubtract(player->client->ps.viewangles[PITCH], ang[PITCH]); // + = looking below the enemy
+	if (fabsf(d_yaw) > 35.0f || fabsf(d_pitch) > 35.0f)
+	{
+		return;
+	}
+
+	const float cx = wheel_x;
+	const float cy = wheel_y;
+	// fixed small size (not tied to the crosshair size, which can be big)
+	(void)crosshair_size;
+	const float radius = mb2_wheel_size->value > 4.0f ? mb2_wheel_size->value : 11.0f;
+	const float width = 1.4f; // fine bars
+
+	// dark ring
+	vec4_t dark = { 0.0f, 0.0f, 0.0f, 0.4f };
+	for (int f = 0; f < 4; f++)
+	{
+		const float fa = DEG2RAD(45.0f + 90.0f * f);
+		MB2_Arc(cx, cy, fa - DEG2RAD(25.0f), fa + DEG2RAD(25.0f), radius, width, dark);
+	}
+
+	// flash after a block result (MB2 colours)
+	const int since_perfect = level.time - mb2_hud_perfect_time;
+	const int since_disarm = level.time - mb2_hud_disarm_time;
+	const int since_mbdef = level.time - mb2_hud_mbdef_time;
+	vec4_t flash = { 0, 0, 0, 0 };
+	if (mb2_hud_disarm_time && since_disarm >= 0 && since_disarm < 450)
+	{
+		MB2_SetColor(flash, 0.3f, 0.6f, 1.0f, 1.0f - since_disarm / 450.0f); // blue = disarm
+	}
+	else if (mb2_hud_perfect_time && since_perfect >= 0 && since_perfect < 300)
+	{
+		MB2_SetColor(flash, 0.5f, 1.0f, 0.5f, 1.0f - since_perfect / 300.0f); // green = perfect block
+	}
+	else if (mb2_hud_mbdef_time && since_mbdef >= 0 && since_mbdef < 300)
+	{
+		MB2_SetColor(flash, 1.0f, 0.85f, 0.1f, 1.0f - since_mbdef / 300.0f); // yellow = MB defense
+	}
+	else if (mb2_hud_hit_time && level.time - mb2_hud_hit_time >= 0 && level.time - mb2_hud_hit_time < 350)
+	{
+		MB2_SetColor(flash, 1.0f, 0.1f, 0.1f, 1.0f - (level.time - mb2_hud_hit_time) / 350.0f); // red = body hit
+	}
+	else if (mb2_hud_clash_time && level.time - mb2_hud_clash_time >= 0 && level.time - mb2_hud_clash_time < 250)
+	{
+		MB2_SetColor(flash, 1.0f, 0.9f, 0.2f, 1.0f - (level.time - mb2_hud_clash_time) / 250.0f); // yellow = saber on saber
+	}
+	if (flash[3] > 0.0f)
+	{
+		// thin outer ring, so the fields stay readable underneath
+		MB2_Arc(cx, cy, 0.0f, 2.0f * M_PI, radius + width + 1.0f, 0.9f, flash);
+	}
+
+	// 4 fixed fields: up-left, down-left, up-right, down-right
+	const qboolean use_aim = !mb2_input->integer ? qtrue : qfalse;
+	const mb2Field_t aim = use_aim ? MB2_AimField(player, enemy) : mb2Field_t{ 0, 0 };
+
+	// incoming swing: locked once per swing (start/attack), transitions
+	// between swings do not change it, so it does not flicker
+	static int last_move = -1;
+	const int move = enemy->client->ps.saberMove;
+	if ((PM_SaberInStart(move) || PM_SaberInAttack(move)) && move != last_move)
+	{
+		const mb2Zone_t z = MB2_IncomingZone(saberMoveData[move].startQuad);
+		if (z.col || z.row)
+		{
+			mb2_hud_inc_zone = z;
+			mb2_hud_inc_time = level.time;
+		}
+	}
+	last_move = move;
+	const int inc_age = level.time - mb2_hud_inc_time;
+	const qboolean inc_on = mb2_hud_inc_time && inc_age >= 0 && inc_age < 900
+		&& (mb2_hud_inc_zone.col || mb2_hud_inc_zone.row) ? qtrue : qfalse;
+	const float inc_alpha = inc_age < 600 ? 1.0f : 1.0f - (inc_age - 600) / 300.0f;
+	const int res = inc_on && use_aim ? MB2_FieldResult(mb2_hud_inc_zone, aim) : 0;
+
+	const float half = DEG2RAD(25.0f); // short bars like the preview
+	for (int f = 0; f < 4; f++)
+	{
+		const float a = DEG2RAD(45.0f + 90.0f * f);
+		const int side = f == 0 || f == 3 ? 1 : -1;   // 45 and 315 degrees are on the right
+		const int height = f <= 1 ? 1 : -1;           // 45 and 135 degrees are up
+		const qboolean is_inc = inc_on && MB2_IncomingInField(mb2_hud_inc_zone, side, height) ? qtrue : qfalse;
+		const qboolean is_aim = use_aim && aim.side == side && aim.height == height ? qtrue : qfalse;
+		vec4_t col;
+		if (is_aim && res == 2)
+		{
+			MB2_SetColor(col, 0.2f, 1.0f, 0.3f, inc_alpha); // green: perfect block ready
+		}
+		else if (is_aim && res == 1)
+		{
+			MB2_SetColor(col, 1.0f, 0.9f, 0.1f, inc_alpha); // yellow: semi block (half cost)
+		}
+		else if (is_inc && mb2_hint->integer)
+		{
+			MB2_SetColor(col, 1.0f, 0.55f, 0.05f, inc_alpha); // orange: the swing comes from here
+		}
+		else if (is_aim)
+		{
+			MB2_SetColor(col, 1.0f, 1.0f, 1.0f, 0.85f); // white: where you aim
+		}
+		else
+		{
+			continue;
+		}
+		MB2_Arc(cx, cy, a - half, a + half, radius, width + (is_inc ? 0.4f : 0.0f), col);
+	}
+}
+
+// ---------------------------------------------------------------------------
+// MB2 feel: no forced parry animation for the player when the sabers only
+// touch while the player is not holding block (e.g. just walking).
+// ---------------------------------------------------------------------------
+static qboolean MB2_Active()
+{
+	MB2_RegisterCvars();
+	return mb2_on->integer && g_SerenityJediEngineMode->integer == 2 ? qtrue : qfalse;
+}
+
+qboolean MB2_SkipIdleParry(const gentity_t* defender)
+{
+	if (!MB2_Active() || !mb2_no_auto_parry->integer || !defender || !defender->client)
+	{
+		return qfalse;
+	}
+	if (!MB2_IsPlayer(defender))
+	{
+		return qfalse;
+	}
+	return defender->client->ps.ManualBlockingFlags & 1 << MBF_HOLDINGBLOCK ? qfalse : qtrue;
+}
+
+// ---------------------------------------------------------------------------
+// Smarter NPC defence
+// ---------------------------------------------------------------------------
+extern qboolean BG_InKnockDown(int anim);
+extern qboolean PM_InKnockDown(const playerState_t* ps);
+extern qboolean PM_SaberInBashedAnim(int anim);
+extern qboolean PM_SaberInMassiveBounce(int move);
+
+// An NPC with its saber in hand keeps its guard up while jumping, rolling or
+// attacking (MB2: you can always block, it only costs more). Not when
+// knocked down, stunned, gripped or out of block points.
+static qboolean MB2_NPCGuarding(const gentity_t* npc)
+{
+	if (MB2_IsPlayer(npc) || !npc->client || npc->health <= 0)
+	{
+		return qfalse;
+	}
+	playerState_t* ps = &npc->client->ps;
+	if (ps->weapon != WP_SABER || !ps->SaberActive() || ps->saberInFlight || ps->blockPoints <= 0)
+	{
+		return qfalse;
+	}
+	if (npc->client->NPC_class == CLASS_GUARD)
+	{
+		return qfalse;
+	}
+	if (BG_InKnockDown(ps->legsAnim) || BG_InKnockDown(ps->torsoAnim) || PM_InKnockDown(ps))
+	{
+		return qfalse;
+	}
+	if (npc->s.eFlags & (EF_FORCE_DRAINED | EF_FORCE_GRIPPED | EF_FORCE_GRASPED))
+	{
+		return qfalse;
+	}
+	if (PM_SaberInBashedAnim(ps->torsoAnim) || PM_SaberInMassiveBounce(ps->torsoAnim))
+	{
+		return qfalse;
+	}
+	return qtrue;
+}
+
+// NPC low on block points: back off (walking) and recover instead of
+// trading hits. Called from the Jedi AI. Returns qtrue while retreating.
+static int mb2_npc_retreat_until[MAX_GENTITIES];
+static int mb2_npc_retreat_cooldown[MAX_GENTITIES];
+static int mb2_npc_regen_time[MAX_GENTITIES];
+
+qboolean MB2_NPCShouldRetreat(gentity_t* npc, const int enemy_dist)
+{
+	if (!MB2_Active() || !npc || !npc->client || MB2_IsPlayer(npc) || mb2_npc_retreat_bp->integer <= 0)
+	{
+		return qfalse;
+	}
+	if (npc->client->ps.weapon != WP_SABER || !npc->enemy || !npc->enemy->client
+		|| npc->enemy->client->ps.weapon != WP_SABER)
+	{
+		return qfalse;
+	}
+	const int n = npc->s.number;
+	if (level.time < mb2_npc_retreat_until[n])
+	{
+		if (level.time >= mb2_npc_regen_time[n])
+		{
+			mb2_npc_regen_time[n] = level.time + 150;
+			wp_block_points_regenerate_over_ride(npc, 1); // recover while backing off
+		}
+		if (npc->client->ps.blockPoints >= mb2_npc_retreat_bp->integer + 25)
+		{
+			mb2_npc_retreat_until[n] = 0; // recovered, fight again
+			return qfalse;
+		}
+		return qtrue;
+	}
+	if (enemy_dist < 220 && npc->client->ps.blockPoints < mb2_npc_retreat_bp->integer
+		&& level.time >= mb2_npc_retreat_cooldown[n])
+	{
+		mb2_npc_retreat_until[n] = level.time + 2500;
+		mb2_npc_retreat_cooldown[n] = level.time + 6000;
+		return qtrue;
+	}
+	return qfalse;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 feel: a real saber swing that reaches the body kills in one hit.
+// Only for actual attacks (not transitions or idle touches).
+// ---------------------------------------------------------------------------
+int MB2_BodyHitDamage(const gentity_t* attacker, const gentity_t* victim, const int damage, int* d_flags)
+{
+	if (!MB2_Active() || !mb2_one_hit->integer)
+	{
+		return damage;
+	}
+	if (!attacker || !attacker->client || !victim || !victim->client || victim->health <= 0 || damage <= 0)
+	{
+		return damage;
+	}
+	if ((MB2_IsPlayer(attacker) || MB2_IsPlayer(victim)) && !(*d_flags & DAMAGE_NO_DAMAGE))
+	{
+		mb2_hud_hit_time = level.time;
+	}
+	if (*d_flags & DAMAGE_NO_DAMAGE)
+	{
+		return damage; // armour (beskar) bounce
+	}
+	if (!PM_SaberInAttack(attacker->client->ps.saberMove)
+		&& !PM_SaberInSpecialAttack(attacker->client->ps.torsoAnim))
+	{
+		return damage; // not a real swing
+	}
+	MB2_GuardRecover(const_cast<gentity_t*>(victim));
+	if (MB2_IsPlayer(attacker) || MB2_IsPlayer(victim))
+	{
+		const playerState_t* vps = &victim->client->ps;
+		MB2_Log(va("BODYHIT %s <- %s: dmg %d, npcblock %d, holdblock %d, parry %d, air %d, arc %d, open %d, saber %d, move %d, BP %d, HP %d",
+			MB2_Name(victim), MB2_Name(attacker), damage,
+			vps->ManualBlockingFlags & 1 << MBF_NPCBLOCKING ? 1 : 0,
+			vps->ManualBlockingFlags & 1 << MBF_HOLDINGBLOCK ? 1 : 0,
+			PM_SaberInParry(vps->saberMove) ? 1 : 0,
+			vps->groundEntityNum == ENTITYNUM_NONE ? 1 : 0,
+			MB2_InBlockArc(victim, attacker) ? 1 : 0,
+			MB2_GuardOpen(victim) ? 1 : 0,
+			vps->saberInFlight ? 0 : 1,
+			vps->saberMove, vps->blockPoints, victim->health));
+	}
+	if (victim->client->ps.ManualBlockingFlags & (1 << MBF_HOLDINGBLOCK | 1 << MBF_NPCBLOCKING)
+		&& victim->client->ps.blockPoints > 0
+		&& !MB2_GuardOpen(victim)
+		&& MB2_InBlockArc(victim, attacker))
+	{
+		MB2_Debug(victim, attacker, va("body hit while blocking - MD damage %d", damage));
+		return damage; // blocking from the front with block points left: normal MD damage
+	}
+	if (MB2_NPCGuarding(victim) && !MB2_GuardOpen(victim) && MB2_InBlockArc(victim, attacker))
+	{
+		// NPC was jumping, rolling or swinging: like MB2 the guard still holds,
+		// but it costs block points (x1.3 in the air) instead of killing.
+		int cost = MB2_BlockCost(victim, attacker);
+		if (victim->client->ps.blockPoints > cost)
+		{
+			PM_AddBlockFatigue(&victim->client->ps, cost);
+			if (MB2_IsPlayer(attacker))
+			{
+				MB2_Debug(victim, attacker, va("NPC guard held (moving), cost %d", cost));
+			}
+			return damage;
+		}
+		victim->client->ps.blockPoints = 0;
+		if (!mb2_guard_break || mb2_guard_break->integer)
+		{
+			// guard breaks: saber knocked away instead of dying
+			MB2_KnockSaberAway(const_cast<gentity_t*>(victim));
+			return damage;
+		}
+	}
+	*d_flags &= ~DAMAGE_NO_KILL;
+	const int lethal = victim->health + victim->client->ps.stats[STAT_ARMOR] + 10;
+	if (MB2_IsPlayer(attacker) || MB2_IsPlayer(victim))
+	{
+		MB2_Debug(victim, attacker, "unblocked hit - lethal");
+	}
+	return lethal > damage ? lethal : damage;
+}
+
+// v18 (Joel): like MB2, a swing that lands on the body stops there and bounces
+// back instead of cutting through. The bounce is the short one (not the slow
+// block bounce), so the next swing of the combo can follow right away.
+// A hit that kills still cuts through. g_MB2BodyBounce 0 = old MD behaviour.
+
+void MB2_BodyHitBounce(gentity_t* attacker, const gentity_t* victim)
+{
+	if (!MB2_Active() || !mb2_body_bounce || !mb2_body_bounce->integer)
+	{
+		return;
+	}
+	if (!attacker || !attacker->client || !victim || !victim->client || victim->health <= 0)
+	{
+		return;
+	}
+	playerState_t* ps = &attacker->client->ps;
+	if (ps->weapon != WP_SABER || ps->saberInFlight || ps->saberLockTime > level.time)
+	{
+		return;
+	}
+	if (!PM_SaberInAttack(ps->saberMove) || PM_SaberInSpecialAttack(ps->torsoAnim))
+	{
+		return; // only normal swings; katas and special attacks keep going
+	}
+	if (ps->saberBlocked != BLOCKED_NONE)
+	{
+		return; // already blocked / bouncing this frame
+	}
+	ps->saberBounceMove = LS_NONE; // pick the bounce that fits this swing
+	ps->saberBlocked = BLOCKED_ATK_BOUNCE;
+	ps->userInt3 &= ~(1 << FLAG_SLOWBOUNCE);
+	ps->saberEventFlags |= SEF_HITENEMY;
+	if (MB2_IsPlayer(attacker) || MB2_IsPlayer(victim))
+	{
+		MB2_Log(va("BODYBOUNCE %s -> %s, move %d", MB2_Name(attacker), MB2_Name(victim), ps->saberMove));
+	}
+}
