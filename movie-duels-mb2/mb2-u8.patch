diff --git a/code/game/wp_saber_mb2.cpp b/code/game/wp_saber_mb2.cpp
new file mode 100644
index 0000000..65c8884
--- /dev/null
+++ b/code/game/wp_saber_mb2.cpp
@@ -0,0 +1,1449 @@
+/*
+===========================================================================
+MB2-style saber blocking layer for Movie Duels (SP).
+Licensed under the GPL v2 like the rest of this code base.
+
+Active when g_MB2Combat is 1 and the Advanced MD combat mode
+(g_SerenityJediEngineMode 2) is on. It replaces the MD rule
+"holding block always blocks in the right direction" with:
+
+  * Blocking works in all directions (like MB2), it only costs block points.
+  * Perfect block (PB): the defender must AIM at the side the swing comes
+    from (mouse aim, like Movie Battles II). A PB costs no block points,
+    gives +8 BP and bounces the attacker.
+  * A normal block (aim wrong) costs block points, based on the attacker's
+    saber style and both fighters' state.
+  * Out of block points: the block breaks (stagger), and the defender can
+    lose the saber.
+  * MBlock / disarm: hold block, tap attack right before the hit, hold the
+    mirrored direction key (W and S swapped) and aim correctly: the attacker
+    loses the saber.
+  * NPCs use the same rules. Their "aim" is a reaction time: they can only
+    perfect block a swing they had time to see, so fast chains and
+    half-swings get through more often. Difficulty and NPC rank set the
+    reaction time and accuracy.
+===========================================================================
+*/
+
+#include "g_local.h"
+#include "anims.h"
+#include "b_local.h"
+#include "wp_saber.h"
+#include "../cgame/cg_local.h"
+
+extern qboolean G_ControlledByPlayer(const gentity_t* self);
+extern qboolean InFront(vec3_t spot, vec3_t from, vec3_t fromAngles, float threshHold);
+extern int PM_AnimLength(int index, animNumber_t anim);
+extern void PM_AddBlockFatigue(playerState_t* ps, int fatigue);
+extern void wp_block_points_regenerate_over_ride(const gentity_t* self, int override_amt);
+extern void wp_saber_clear_damage_for_ent_num(gentity_t* attacker, int entityNum, int saber_num, int blade_num);
+extern qboolean WP_SaberMBlock(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num, vec3_t hit_loc);
+extern qboolean WP_SaberParry(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num);
+extern qboolean WP_SaberFatiguedParry(gentity_t* victim, gentity_t* attacker, int saber_num, int blade_num, vec3_t hit_loc);
+extern void SabBeh_AnimateSlowBounce(gentity_t* self);
+extern void G_Stagger(gentity_t* hit_ent);
+extern void SabBeh_SaberShouldBeDisarmedBlocker(gentity_t* blocker, int saber_num);
+extern void sab_beh_saber_should_be_disarmed_attacker(gentity_t* attacker, int saber_num);
+extern qboolean PM_SaberInnonblockableAttack(int anim);
+extern qboolean PM_SaberInParry(int move);
+extern void CGCam_BlockShakeSP(float intensity, int duration);
+extern qboolean PM_SaberInStart(int move);
+extern qboolean PM_SaberInSpecialAttack(int anim);
+extern qboolean PM_SaberInAttack(int move);
+extern qboolean PM_SaberInTransition(int move);
+extern void G_StartStasisEffect_FORCE_LEVEL_1(const gentity_t* ent, int me_flags, int length, float time_scale, int spin_time);
+extern cvar_t* g_SerenityJediEngineMode;
+extern cvar_t* d_slowmoaction;
+extern cvar_t* d_blockinfo;
+
+// ---------------------------------------------------------------------------
+// Settings (console variables, saved in the config)
+// ---------------------------------------------------------------------------
+static cvar_t* mb2_on;          // 1 = MB2 blocking on
+static cvar_t* mb2_input;       // 0 = aim with the mouse (MB2), 1 = movement keys (controller)
+static cvar_t* mb2_aim_yaw;     // degrees left/right of the enemy that count as "left/right"
+static cvar_t* mb2_aim_pitch;   // degrees above/below the enemy that count as "high/low"
+static cvar_t* mb2_npc_react;   // NPC reaction time in percent (100 = default)
+static cvar_t* mb2_back_damage; // damage of a hit that could not be blocked (from behind)
+static cvar_t* mb2_debug;       // 1 = print what happened on each block
+static cvar_t* mb2_one_hit;     // 1 = a saber hit that is not blocked kills (MB2)
+static cvar_t* mb2_no_auto_parry; // 1 = no automatic parry for the player when not holding block
+static cvar_t* mb2_npc_arc_bonus; // extra block arc for NPCs in degrees
+static cvar_t* mb2_npc_retreat_bp; // NPCs back off below this many block points (0 = off)
+static cvar_t* mb2_block_arc;   // width of the block in degrees in front of you (360 = all around)
+static cvar_t* mb2_body_bounce; // 1 = a body hit stops the swing and bounces back (v18)
+
+static void MB2_RegisterCvars()
+{
+	if (mb2_on)
+	{
+		return;
+	}
+	mb2_on = gi.cvar("g_MB2Combat", "1", CVAR_ARCHIVE);
+	mb2_input = gi.cvar("g_MB2BlockInput", "0", CVAR_ARCHIVE);
+	mb2_aim_yaw = gi.cvar("g_MB2AimYaw", "9", CVAR_ARCHIVE);
+	mb2_aim_pitch = gi.cvar("g_MB2AimPitch", "7", CVAR_ARCHIVE);
+	mb2_npc_react = gi.cvar("g_MB2NPCReaction", "100", CVAR_ARCHIVE);
+	mb2_back_damage = gi.cvar("g_MB2BackHitDamage", "30", CVAR_ARCHIVE);
+	mb2_debug = gi.cvar("g_MB2Debug", "0", CVAR_ARCHIVE);
+	mb2_one_hit = gi.cvar("g_MB2OneHitKillOn", "0", CVAR_ARCHIVE); // v16 (Joel): normal health by default; new name so the old saved value does not apply
+	mb2_no_auto_parry = gi.cvar("g_MB2NoAutoParry", "1", CVAR_ARCHIVE);
+	mb2_block_arc = gi.cvar("g_MB2BlockArc", "150", CVAR_ARCHIVE);
+	mb2_npc_arc_bonus = gi.cvar("g_MB2NPCBlockArcBonus", "60", CVAR_ARCHIVE);
+	mb2_npc_retreat_bp = gi.cvar("g_MB2NPCRetreatBP", "30", CVAR_ARCHIVE);
+	mb2_body_bounce = gi.cvar("g_MB2BodyBounce", "1", CVAR_ARCHIVE);
+}
+
+// ---------------------------------------------------------------------------
+// Zones on a 3x3 grid as seen by the defender: column -1 left, 0 middle,
+// 1 right; row 1 high, 0 middle, -1 low.
+// ---------------------------------------------------------------------------
+struct mb2Zone_t
+{
+	int col;
+	int row;
+};
+
+// Where the swing comes from, seen by the DEFENDER. The attacker's right is
+// the defender's left, so the side is mirrored.
+static mb2Zone_t MB2_IncomingZone(const int start_quad)
+{
+	switch (start_quad)
+	{
+	case Q_TR: return { -1, 1 };
+	case Q_T: return { 0, 1 };
+	case Q_TL: return { 1, 1 };
+	case Q_R: return { -1, 0 };
+	case Q_L: return { 1, 0 };
+	case Q_BR: return { -1, -1 };
+	case Q_B: return { 0, -1 };
+	case Q_BL: return { 1, -1 };
+	default: return { 0, 0 };
+	}
+}
+
+static int MB2_Sign(const float v, const float dead)
+{
+	if (v > dead) return 1;
+	if (v < -dead) return -1;
+	return 0;
+}
+
+// Movement keys as a zone (controller option, and the MBlock key check).
+static mb2Zone_t MB2_KeyZone(const gentity_t* ent)
+{
+	mb2Zone_t z;
+	z.col = MB2_Sign(ent->client->pers.cmd.rightmove, 0);
+	z.row = MB2_Sign(ent->client->pers.cmd.forwardmove, 0);
+	return z;
+}
+
+// ---------------------------------------------------------------------------
+// MB2 zones (research: 7 PB zones attached to the enemy body + 6 overlaps).
+// Angles as seen by the defender on screen: 0 = right, 90 = up.
+//   D 0, WD 45, W 90, WA 135, A 180, SA 225, SD 315  (no zone straight down)
+// The aim is measured relative to the enemy's body size, so up close you
+// have to move the mouse further than from a distance (like MB2).
+// ---------------------------------------------------------------------------
+static const float mb2_zone_deg[7] = { 0.0f, 45.0f, 90.0f, 135.0f, 180.0f, 225.0f, 315.0f };
+
+static float MB2_AngDiff(const float a, const float b)
+{
+	float d = fmodf(fabsf(a - b), 360.0f);
+	return d > 180.0f ? 360.0f - d : d;
+}
+
+// Overlap width at zone borders ("magic overlaps"), wider on easier skill.
+static float MB2_Overlap()
+{
+	switch (g_spskill->integer)
+	{
+	case 0: return 18.0f;
+	case 1: return 10.0f;
+	default: return 6.0f;
+	}
+}
+
+// Defender's aim around the attacker's body. Returns qfalse when aiming at
+// the middle of the body (no zone).
+static qboolean MB2_AimAngle(const gentity_t* blocker, const gentity_t* attacker, float* out_deg)
+{
+	vec3_t from, to, dir, ang;
+	VectorCopy(blocker->client->ps.origin, from);
+	from[2] += blocker->client->ps.viewheight;
+	VectorCopy(attacker->client->ps.origin, to);
+	to[2] += attacker->client->ps.viewheight * 0.5f; // middle of the chest (eyes are at viewheight)
+	VectorSubtract(to, from, dir);
+	const float dist = VectorLength(dir) < 16.0f ? 16.0f : VectorLength(dir);
+	vectoangles(dir, ang);
+
+	const float d_yaw = AngleSubtract(blocker->client->ps.viewangles[YAW], ang[YAW]);       // + = left of the body
+	const float d_pitch = AngleSubtract(blocker->client->ps.viewangles[PITCH], ang[PITCH]); // + = below the body
+
+	// half body width / height in degrees at this distance
+	float ang_w = RAD2DEG(atan2f(16.0f, dist));
+	float ang_h = RAD2DEG(atan2f(26.0f, dist));
+	if (ang_w < 3.0f) ang_w = 3.0f;
+	if (ang_h < 4.0f) ang_h = 4.0f;
+
+	const float ox = -d_yaw / ang_w;
+	const float oy = -d_pitch / ang_h;
+	if (ox * ox + oy * oy < 0.3f * 0.3f) // only the very middle of the chest is "no zone"
+	{
+		return qfalse;
+	}
+	float deg = RAD2DEG(atan2f(oy, ox));
+	if (deg < 0.0f) deg += 360.0f;
+	*out_deg = deg;
+	return qtrue;
+}
+
+// Screen angle of the incoming swing zone; Q_B swings (from below) count for
+// both low zones.
+static float MB2_IncomingDeg(const mb2Zone_t& inc)
+{
+	float deg = RAD2DEG(atan2f(static_cast<float>(inc.row), static_cast<float>(inc.col)));
+	if (deg < 0.0f) deg += 360.0f;
+	return deg;
+}
+
+static qboolean MB2_AimMatches(const mb2Zone_t& inc, const float aim_deg)
+{
+	if (!inc.col && !inc.row)
+	{
+		return qfalse;
+	}
+	const float reach = 22.5f + MB2_Overlap();
+	if (inc.col == 0 && inc.row == -1)
+	{
+		return MB2_AngDiff(aim_deg, 225.0f) <= reach || MB2_AngDiff(aim_deg, 315.0f) <= reach ? qtrue : qfalse;
+	}
+	return MB2_AngDiff(aim_deg, MB2_IncomingDeg(inc)) <= reach ? qtrue : qfalse;
+}
+
+// Semi block (old MB2 "semi-perfect block"): aimed one zone next to the
+// right one. Still a normal block, but it only costs half the block points.
+static qboolean MB2_AimSemi(const mb2Zone_t& inc, const float aim_deg)
+{
+	if (!inc.col && !inc.row)
+	{
+		return qfalse;
+	}
+	const float reach = 22.5f + MB2_Overlap() + 45.0f;
+	if (inc.col == 0 && inc.row == -1)
+	{
+		return MB2_AngDiff(aim_deg, 225.0f) <= reach || MB2_AngDiff(aim_deg, 315.0f) <= reach ? qtrue : qfalse;
+	}
+	return MB2_AngDiff(aim_deg, MB2_IncomingDeg(inc)) <= reach ? qtrue : qfalse;
+}
+
+// ---------------------------------------------------------------------------
+// 4 fields (Joel, v13): up-left, down-left, up-right, down-right.
+// Field = (side, height): side -1 left / 1 right, height 1 up / -1 down.
+// A swing from the left counts for both left fields, from above for both
+// upper fields (like MB2's overlaps). Diagonal swings need their own field;
+// the other field on the same side is a semi block (half cost).
+// The aim uses hysteresis so the field does not flicker at the borders.
+// ---------------------------------------------------------------------------
+struct mb2Field_t
+{
+	int side;
+	int height;
+};
+static mb2Field_t mb2_aim_field[MAX_GENTITIES];
+static int mb2_aim_field_time[MAX_GENTITIES];
+static mb2Field_t mb2_aim_pending[MAX_GENTITIES];
+static int mb2_aim_pending_since[MAX_GENTITIES];
+
+static mb2Field_t MB2_AimField(const gentity_t* blocker, const gentity_t* attacker)
+{
+	vec3_t from, to, dir, ang;
+	VectorCopy(blocker->client->ps.origin, from);
+	from[2] += blocker->client->ps.viewheight;
+	VectorCopy(attacker->client->ps.origin, to);
+	to[2] += attacker->client->ps.viewheight * 0.5f; // middle of the chest
+	VectorSubtract(to, from, dir);
+	const float dist = VectorLength(dir) < 16.0f ? 16.0f : VectorLength(dir);
+	vectoangles(dir, ang);
+	const float d_yaw = AngleSubtract(blocker->client->ps.viewangles[YAW], ang[YAW]);       // + = left of the body
+	const float d_pitch = AngleSubtract(blocker->client->ps.viewangles[PITCH], ang[PITCH]); // + = below the body
+	float ang_w = RAD2DEG(atan2f(16.0f, dist));
+	float ang_h = RAD2DEG(atan2f(26.0f, dist));
+	if (ang_w < 3.0f) ang_w = 3.0f;
+	if (ang_h < 4.0f) ang_h = 4.0f;
+	const float ox = -d_yaw / ang_w;   // + = right
+	const float oy = -d_pitch / ang_h; // + = up
+
+	const int n = blocker->s.number;
+	mb2Field_t f = mb2_aim_field[n];
+	if (level.time - mb2_aim_field_time[n] > 1000 || !f.side || !f.height)
+	{
+		f.side = ox < 0.0f ? -1 : 1;
+		f.height = oy < 0.0f ? -1 : 1;
+	}
+	// switch only when clearly over the border (hysteresis) and only after
+	// the new field was held for a moment, so it is calm to look at
+	const float hyst = 0.25f;
+	mb2Field_t want = f;
+	if (f.side == 1 && ox < -hyst) want.side = -1;
+	else if (f.side == -1 && ox > hyst) want.side = 1;
+	if (f.height == 1 && oy < -hyst) want.height = -1;
+	else if (f.height == -1 && oy > hyst) want.height = 1;
+	if (want.side != f.side || want.height != f.height)
+	{
+		if (!mb2_aim_pending_since[n] || mb2_aim_pending[n].side != want.side || mb2_aim_pending[n].height != want.height)
+		{
+			mb2_aim_pending[n] = want;
+			mb2_aim_pending_since[n] = level.time;
+		}
+		else if (level.time - mb2_aim_pending_since[n] >= 150)
+		{
+			f = want;
+			mb2_aim_pending_since[n] = 0;
+		}
+	}
+	else
+	{
+		mb2_aim_pending_since[n] = 0;
+	}
+	mb2_aim_field[n] = f;
+	mb2_aim_field_time[n] = level.time;
+	return f;
+}
+
+// 2 = perfect, 1 = semi, 0 = wrong
+static int MB2_FieldResult(const mb2Zone_t& inc, const mb2Field_t& f)
+{
+	if (!inc.col && !inc.row)
+	{
+		return 0;
+	}
+	if (inc.col && inc.row)
+	{
+		if (f.side == inc.col && f.height == inc.row) return 2;
+		if (f.side == inc.col) return 1; // same side, other height
+		return 0;
+	}
+	if (inc.col)
+	{
+		return f.side == inc.col ? 2 : 0; // horizontal: both fields of that side
+	}
+	return f.height == inc.row ? 2 : 0; // from above / below: both fields of that height
+}
+
+// Is field (side,height) one the swing comes from (for the indicator)?
+static qboolean MB2_IncomingInField(const mb2Zone_t& inc, const int side, const int height)
+{
+	if (!inc.col && !inc.row)
+	{
+		return qfalse;
+	}
+	if (inc.col && inc.row) return side == inc.col && height == inc.row ? qtrue : qfalse;
+	if (inc.col) return side == inc.col ? qtrue : qfalse;
+	return height == inc.row ? qtrue : qfalse;
+}
+
+// Does the incoming swing belong to field i (for the indicator)?
+static qboolean MB2_IncomingIsField(const mb2Zone_t& inc, const int i)
+{
+	if (!inc.col && !inc.row)
+	{
+		return qfalse;
+	}
+	if (inc.col == 0 && inc.row == -1)
+	{
+		return i == 5 || i == 6 ? qtrue : qfalse;
+	}
+	return MB2_AngDiff(MB2_IncomingDeg(inc), mb2_zone_deg[i]) < 1.0f ? qtrue : qfalse;
+}
+
+// How close the aim must be: hard = exact zone, normal = exact or one step
+// up/down/left/right, easy = any neighbour (diagonals too).
+static qboolean MB2_ZoneMatches(const mb2Zone_t& want, const mb2Zone_t& have)
+{
+	if (have.col == 0 && have.row == 0)
+	{
+		return qfalse; // aiming straight at the enemy is not a perfect block, you have to aim at the swing
+	}
+	const int dc = abs(want.col - have.col);
+	const int dr = abs(want.row - have.row);
+	if (dc == 0 && dr == 0)
+	{
+		return qtrue;
+	}
+	if (g_spskill->integer <= 0)
+	{
+		return dc <= 1 && dr <= 1 ? qtrue : qfalse;
+	}
+	if (g_spskill->integer == 1)
+	{
+		return dc + dr <= 1 ? qtrue : qfalse;
+	}
+	return qfalse;
+}
+
+// ---------------------------------------------------------------------------
+// Block point cost of a normal (not perfect) block, MB2 style:
+// heavier styles drain more, and the state of both fighters scales it.
+// ---------------------------------------------------------------------------
+// MB2 (Release 21) style ratings: offense AP / defense DP.
+// Movie Duels style -> MB2 style: fast=Blue, Tavion=Cyan, medium=Yellow,
+// staff=Staff, dual=Duals, Desann=Purple, strong=Red.
+static void MB2_StyleRating(const int style, float* ap, float* dp)
+{
+	switch (style)
+	{
+	case SS_FAST: *ap = 7; *dp = 55; return;
+	case SS_TAVION: *ap = 8; *dp = 48; return;
+	case SS_STAFF: *ap = 8; *dp = 53; return;
+	case SS_DUAL: *ap = 8; *dp = 50; return;
+	case SS_DESANN: *ap = 11; *dp = 48; return;
+	case SS_STRONG: *ap = 12; *dp = 48; return;
+	case SS_MEDIUM:
+	default: *ap = 9; *dp = 50; return;
+	}
+}
+
+// BP drain of a blocked swing: 100 * attacker AP / defender DP (MB2 R21),
+// half for follow-up swings of a combo, plus the R21 state multipliers.
+static int MB2_BlockCost(const gentity_t* blocker, const gentity_t* attacker)
+{
+	float ap, dp, unused;
+	MB2_StyleRating(attacker->client->ps.saberAnimLevel, &ap, &unused);
+	MB2_StyleRating(blocker->client->ps.saberAnimLevel, &unused, &dp);
+	float cost = 100.0f * ap / dp;
+
+	if (attacker->client->ps.saberAttackChainCount > 1)
+	{
+		cost *= 0.5f; // later swings of a combo drain half
+	}
+	if (attacker->client->ps.pm_flags & PMF_DUCKED)
+	{
+		cost *= 0.75f; // crouch attack
+	}
+	if (blocker->client->ps.pm_flags & PMF_DUCKED)
+	{
+		cost *= 1.25f; // crouched defender
+	}
+	if (blocker->client->ps.ManualBlockingFlags & 1 << MBF_HOLDINGBLOCKANDATTACK)
+	{
+		cost *= 1.2f; // caught mid-swing
+	}
+	if (blocker->client->ps.groundEntityNum == ENTITYNUM_NONE)
+	{
+		cost *= 1.3f; // defender in the air (MB2)
+	}
+
+	const int result = static_cast<int>(cost + 0.5f);
+	return result < 1 ? 1 : result;
+}
+
+// ---------------------------------------------------------------------------
+// NPC "aim": a reaction time. The NPC can perfect block a swing only once
+// it had time to see where it comes from.
+// ---------------------------------------------------------------------------
+static int MB2_NPCReactionMs(const gentity_t* npc)
+{
+	int react;
+	switch (g_spskill->integer)
+	{
+	case 0: react = 460; break;
+	case 1: react = 330; break;
+	default: react = 230; break;
+	}
+	if (npc->NPC)
+	{
+		if (npc->NPC->rank >= RANK_CAPTAIN)
+		{
+			react -= 90; // bosses / masters
+		}
+		else if (npc->NPC->rank >= RANK_LT_COMM)
+		{
+			react -= 50;
+		}
+		else if (npc->NPC->rank <= RANK_CREWMAN)
+		{
+			react += 80; // padawans, cultists
+		}
+	}
+	react = react * mb2_npc_react->integer / 100;
+	return react < 60 ? 60 : react;
+}
+
+static int MB2_NPCPerfectChance(const gentity_t* npc)
+{
+	int chance;
+	switch (g_spskill->integer)
+	{
+	case 0: chance = 35; break;
+	case 1: chance = 55; break;
+	default: chance = 75; break;
+	}
+	if (npc->NPC && npc->NPC->rank >= RANK_CAPTAIN)
+	{
+		chance += 15;
+	}
+	return chance;
+}
+
+static int MB2_NPCDisarmChance(const gentity_t* npc)
+{
+	int chance;
+	switch (g_spskill->integer)
+	{
+	case 0: chance = 2; break;
+	case 1: chance = 5; break;
+	default: chance = 9; break;
+	}
+	if (npc->NPC && npc->NPC->rank >= RANK_CAPTAIN)
+	{
+		chance += 5;
+	}
+	return chance;
+}
+
+// Chance (of the swings that were not perfect blocked) to at least semi block.
+static int MB2_NPCSemiChance(const gentity_t* npc)
+{
+	int chance;
+	switch (g_spskill->integer)
+	{
+	case 0: chance = 30; break;
+	case 1: chance = 45; break;
+	default: chance = 60; break;
+	}
+	if (npc->NPC && npc->NPC->rank >= RANK_CAPTAIN)
+	{
+		chance += 15;
+	}
+	return chance;
+}
