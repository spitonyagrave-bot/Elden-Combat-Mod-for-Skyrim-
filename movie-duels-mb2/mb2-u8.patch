+static void MB2_Debug(const gentity_t* blocker, const gentity_t* attacker, const char* what)
+{
+	if (MB2_IsPlayer(blocker) || MB2_IsPlayer(attacker))
+	{
+		if (mb2_debug->integer || d_blockinfo->integer)
+		{
+			gi.Printf(S_COLOR_GREEN "MB2: %s (BP %d)\n", what, blocker->client->ps.blockPoints);
+		}
+		MB2_Log(va("%s <- %s: %s (BP %d, HP %d)", MB2_Name(blocker), MB2_Name(attacker), what,
+			blocker->client->ps.blockPoints, blocker->health));
